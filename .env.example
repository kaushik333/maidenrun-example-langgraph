# --- LLM provider: set exactly one. Env var name is a fixed convention, ---
# --- matching the platform's provider dropdown (see IDEA.md).            ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- optional: additional env var, wired through the platform's ---
# --- "Additional environment variables" field. Without it, web search ---
# --- falls back to DuckDuckGo (no key required). ---
# TAVILY_API_KEY=

# --- logging (logs/<user-id>/<run-id>/...) ---
LOG_DIR=logs
USER_ID=local
LOG_LEVEL=INFO
